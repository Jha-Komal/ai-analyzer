generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Review {
  id         String    @id @default(uuid())
  review     String
  rating     Float?
  source     String
  username   String?
  reviewDate DateTime?
  language   String?
  createdAt  DateTime  @default(now())

  analysis ReviewAnalysis?
}

model ReviewAnalysis {
  id                    String   @id @default(uuid())
  reviewId              String   @unique
  sentiment             String
  emotion               String
  themes                String
  painPoints            String
  shoppingHabit         String?
  barrier               String?
  experimentLikelihood  String?
  featureRequests       String
  category              String?
  summary               String
  confidence            Float
  createdAt             DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id])
}

model DashboardCache {
  id                    String   @id @default(uuid())
  totalCount            Int      @default(0)
  positiveCount         Int
  neutralCount          Int
  negativeCount         Int
  averageRating         Float    @default(0)
  themeDistribution     String
  emotionDistribution   String
  categoryDistribution  String
  painPointDistribution String
  sourceDistribution         String   @default("{}")
  shoppingHabitDistribution  String   @default("{}")
  barrierDistribution        String   @default("{}")
  sentimentTrend             String   @default("[]")
  recommendationSummary      String?
  updatedAt             DateTime @updatedAt
}

model InsightRun {
  id                     String   @id @default(uuid())
  sampleSize             Int      @default(0)
  totalReviewsConsidered Int      @default(0)
  batchSummaries         String   @default("[]")
  crossQuestionPatterns  String   @default("[]")
  behavioralSegments     String   @default("[]")
  researchLimitations    String   @default("[]")
  qualityChecks          String   @default("{}")
  createdAt              DateTime @default(now())

  insights Insight[]
}

model Insight {
  id                                 String   @id @default(uuid())
  runId                              String
  questionId                         Int
  question                           String
  answerStatus                       String
  directAnswer                       String
  categoryExpansionConnection        String   @default("{}")
  keyFindings                        String   @default("[]")
  counterEvidence                    String   @default("[]")
  generalPlatformIssuesExcluded      String   @default("[]")
  categoryEligibilityConsiderations  String   @default("[]")
  evidenceGaps                       String   @default("[]")
  allSupportingReviewIds             String   @default("[]")
  evidenceStrengthScore              Float    @default(0)
  evidenceStrengthBand               String   @default("insufficient")
  evidenceStrengthDetail             String   @default("{}")
  primaryCategoryExpansionRelevance  String   @default("unclear")
  createdAt                          DateTime @default(now())

  run InsightRun @relation(fields: [runId], references: [id])
}

model Recommendation {
  id                          String   @id @default(uuid())
  priority                    String
  title                       String
  description                 String
  categoryExpansionRelevance  String   @default("unclear")
  basedOnQuestionIds          String   @default("[]")
  supportingFindingRefs       String   @default("[]")
  supportingReviewIds         String   @default("[]")
  createdAt                   DateTime @default(now())
}
