generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Review {
  id         String    @id @default(uuid())
  review     String
  rating     Float?
  source     String
  username   String?
  reviewDate DateTime?
  language   String?
  createdAt  DateTime  @default(now())

  analysis ReviewAnalysis?
}

model ReviewAnalysis {
  id                    String   @id @default(uuid())
  reviewId              String   @unique
  sentiment             String
  emotion               String
  themes                String
  painPoints            String
  shoppingHabit         String?
  barrier               String?
  experimentLikelihood  String?
  featureRequests       String
  summary               String
  confidence            Float
  createdAt             DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id])
}

model DashboardCache {
  id                    String   @id @default(uuid())
  positiveCount         Int
  neutralCount          Int
  negativeCount         Int
  themeDistribution     String
  emotionDistribution   String
  categoryDistribution  String
  painPointDistribution String
  recommendationSummary String?
  updatedAt             DateTime @updatedAt
}

model Insight {
  id                  String   @id @default(uuid())
  question            String
  answer              String
  confidence          Float
  supportingReviewIds String
  createdAt           DateTime @default(now())
}

model Recommendation {
  id          String   @id @default(uuid())
  priority    String
  title       String
  description String
  createdAt   DateTime @default(now())
}
